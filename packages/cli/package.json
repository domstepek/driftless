{
  "name": "@driftless/cli",
  "version": "1.0.0",
  "description": "Generate and maintain living documentation from your e2e tests",
  "bin": {
    "driftless": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/domstepek/driftless.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "homepage": "https://github.com/domstepek/driftless#readme",
  "author": "Dom Stepek",
  "keywords": [
    "driftless",
    "documentation",
    "e2e",
    "testing",
    "cli",
    "ai",
    "docs-from-tests"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@driftless/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
